{
	"name": "@standard-config/eslint",
	"version": "2.2.0",
	"description": "TypeScript-first ESLint config designed to complement Oxlint",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/standard-config/eslint.git"
	},
	"keywords": [
		"eslint",
		"eslint-config",
		"flat-config",
		"oxc",
		"oxlint",
		"react",
		"standard-config",
		"type-aware",
		"typescript"
	],
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./utilities": {
			"types": "./dist/utilities.d.mts",
			"import": "./dist/utilities.mjs"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.0.3",
	"dependencies": {
		"@eslint-react/eslint-plugin": "^5.7.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-plugin-perfectionist": "^5.9.0"
	},
	"peerDependencies": {
		"@standard-config/oxlint": ">=1.3.0",
		"eslint": ">=10.2.1",
		"typescript-eslint": ">=8.56.0"
	},
	"peerDependenciesMeta": {
		"@standard-config/oxlint": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"typescript-eslint": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@standard-config/oxlint": "^1.9.0",
		"@standard-config/prettier": "^1.13.0",
		"@standard-config/tsconfig": "^3.1.0",
		"@types/node": "^22.19.18",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.3.0",
		"jiti": "^2.6.1",
		"oxlint": "catalog:",
		"prettier": "^3.8.3",
		"publint": "^0.3.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vite-plus": "^0.1.20",
		"vitest": "^4.1.5"
	},
	"scripts": {
		"build": "vp pack",
		"fix": "pnpm format && pnpm lint && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint": "vp lint --fix && eslint --fix .",
		"lint:check": "vp lint --deny-warnings --type-check && eslint .",
		"prepack": "pnpm run '/^(format:check|lint:check|test|typecheck)$/' && pnpm build",
		"prepare": "vp config",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	}
}
